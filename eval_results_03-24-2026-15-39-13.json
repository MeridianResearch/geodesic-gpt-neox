            "config_files": {
                "nemotron3_nano_30b_eval_mmlu.yml": "{\n  # Nemotron-3-Nano-30B Evaluation Config (MMLU)\n  # Model: nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-Base-BF16\n  # Hybrid architecture: Mamba2 + MoE + Attention (52 layers)\n\n  \"load\": \"/projects/a5k/public/checkpoints/sf_model_organisms/NVIDIA-Nemotron-3-Nano-30B-A3B-Base-BF16\",\n  \"finetune\": true,\n  \"iteration\": 0,\n\n  # Architecture\n  \"num_layers\": 52,\n  \"hidden_size\": 2688,\n  \"num_attention_heads\": 32,\n  \"num_kv_heads\": 2,\n  \"head_dim\": 128,\n  \"seq_length\": 4096,\n  \"max_position_embeddings\": 262144,\n  \"make_vocab_size_divisible_by\": 1,\n\n  # Nemotron hybrid block pattern\n  \"nemotron_hybrid_pattern\": \"MEMEM*EMEMEM*EMEMEM*EMEMEM*EMEMEM*EMEMEMEM*EMEMEMEME\",\n\n  # Norms and activations\n  \"norm\": \"rmsnorm\",\n  \"rms_norm_epsilon\": 1.0e-5,\n  \"activation\": \"relu2\",\n  \"use_bias_in_attn_linear\": false,\n  \"use_bias_in_mlp\": false,\n  \"use_bias_in_norms\": false,\n\n  # Positional embeddings - Nemotron uses NoPE (No Positional Encoding)\n  # for attention layers, relying on Mamba's implicit position encoding\n  \"pos_emb\": \"none\",\n\n  # Mamba2 parameters\n  \"mamba2_num_heads\": 64,\n  \"mamba2_head_dim\": 64,\n  \"mamba2_state_size\": 128,\n  \"mamba2_conv_kernel\": 4,\n  \"mamba2_n_groups\": 8,\n  \"mamba2_chunk_size\": 128,\n  \"mamba2_expand\": 2,\n  \"mamba2_use_conv_bias\": true,\n\n  # MoE parameters\n  \"moe_num_experts\": 128,\n  \"moe_n_shared_experts\": 1,\n  \"moe_top_k\": 6,\n  \"moe_routed_intermediate_size\": 1856,\n  \"moe_shared_expert_intermediate_size\": 3712,\n  \"moe_routed_scaling_factor\": 2.5,\n  \"moe_routing_type\": \"sigmoid_topk\",\n  \"moe_n_group\": 1,\n  \"moe_topk_group\": 1,\n  \"moe_e_score_correction\": true,\n\n  # Tokenizer\n  \"vocab_file\": \"/projects/a5k/public/checkpoints/sf_model_organisms/NVIDIA-Nemotron-3-Nano-30B-A3B-Base-BF16/tokenizer/tokenizer.json\",\n  \"tokenizer_type\": \"HFTokenizer\",\n\n  # Model config\n  \"no_weight_tying\": true,\n  \"gpt_j_residual\": false,\n  \"output_layer_parallelism\": \"column\",\n  \"scaled_upper_triang_masked_softmax_fusion\": false,\n  \"precision\": \"bfloat16\",\n\n  # Parallelism \u2014 use pipe=1 to keep PipelineModule wrapper\n  # 30B fits on 1 GH200 (95GB) in bf16 (~60GB weights)\n  \"pipe_parallel_size\": 1,\n  \"model_parallel_size\": 1,\n\n  # Evaluation settings\n  \"eval_tasks\": [\"mmlu_abstract_algebra\", \"mmlu_anatomy\", \"mmlu_astronomy\", \"mmlu_business_ethics\", \"mmlu_college_biology\", \"mmlu_college_chemistry\", \"mmlu_college_computer_science\", \"mmlu_college_mathematics\", \"mmlu_college_medicine\", \"mmlu_college_physics\"],\n\n  # Training settings (not used for eval, but required)\n  \"train_micro_batch_size_per_gpu\": 1,\n  \"gradient_accumulation_steps\": 1,\n  \"train_iters\": 0,\n  \"zero_optimization\": {\"stage\": 0},\n  \"optimizer\": {\"type\": \"Adam\", \"params\": {\"lr\": 0.0001}},\n\n  # Logging\n  \"log_interval\": 1,\n  \"steps_per_print\": 1,\n  \"use_wandb\": false,\n\n  # Checkpointing\n  \"checkpoint_activations\": false,\n}\n"
            },
